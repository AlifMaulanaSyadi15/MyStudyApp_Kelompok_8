<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warna_latar"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== kepala halaman: nama app, sapaan, judul, info singkat ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvNamaApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/warna_aksen"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- pengembangan tambahan: sapaan nama profil (tersembunyi bila nama kosong) -->
            <TextView
                android:id="@+id/tvSapaan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#C9D6E4"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvJudul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/judul_utama"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubJudul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/sub_utama"
                android:textColor="#C9D6E4"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ===== kartu informasi: materi_judul ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/ivMateri"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_ikon"
                android:gravity="center"
                android:text="📚"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/materi_judul"
                    android:textColor="@color/warna_teks_utama"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMateriIsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/materi_isi"
                    android:textColor="@color/warna_teks_sekunder"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== kartu informasi: jadwal_judul ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/ivJadwal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_ikon"
                android:gravity="center"
                android:text="📅"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/jadwal_judul"
                    android:textColor="@color/warna_teks_utama"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvJadwalIsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/jadwal_isi"
                    android:textColor="@color/warna_teks_sekunder"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== kartu informasi: tugas_judul ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kartu"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/ivTugas"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_ikon"
                android:gravity="center"
                android:text="📋"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tugas_judul"
                    android:textColor="@color/warna_teks_utama"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTugasIsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tugas_isi"
                    android:textColor="@color/warna_teks_sekunder"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== ringkasan pengaturan aktif ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_kotak_ringkasan"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pengaturan_aktif"
                android:textAllCaps="true"
                android:textColor="@color/warna_teks_sekunder"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRingkasan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/warna_teks_utama"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== tombol menuju halaman pengaturan ===== -->
        <Button
            android:id="@+id/btnPengaturan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_pengaturan" />

    </LinearLayout>
</ScrollView>
